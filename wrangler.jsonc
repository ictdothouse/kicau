{
  // Nama Worker. URL selepas deploy: https://kicau.<subdomain-anda>.workers.dev
  "name": "kicau",
  "main": "api/worker.js",
  "compatibility_date": "2026-10-01",

  // Fail frontend (HTML/CSS/JS) dihantar terus ke browser.
  // Request yang bukan fail statik (contoh /api/posts) akan sampai ke api/worker.js.
  "assets": { "directory": "./frontend" },

  // Database D1 (data teks). Dalam kod Worker: env.DB
  // Akaun anda sendiri: npx wrangler d1 create kicau-db, kemudian salin "database_id" ke sini.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kicau-db",
      "database_id": "d303d833-a148-4931-9f02-d7c0361d872b"
    }
  ],

  // Namespace KV (fail gambar & video). Dalam kod Worker: env.MEDIA
  // Akaun anda sendiri: npx wrangler kv namespace create kicau-media, kemudian salin "id" ke sini.
  // Untuk "npm run dev" di komputer sendiri, kedua-dua id boleh dibiarkan seperti ini.
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "GANTI-DENGAN-ID-KV"
    }
  ]
}
